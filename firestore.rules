rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 편집 권한: 구글 로그인한 e.eam8090@gmail.com 계정만
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'e.eam8090@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 저장되는 내용의 모양과 길이 제한
    function isValidProfile(d) {
      return d.keys().hasAll(['nick', 'handle', 'badges', 'greeting', 'warns', 'mute',
                              'note', 'likes', 'chars', 'more', 'pairsSens', 'pairsSafe'])
        && d.keys().hasOnly(['nick', 'handle', 'badges', 'greeting', 'warns', 'mute',
                             'note', 'likes', 'chars', 'more', 'pairsSens', 'pairsSafe'])
        && d.nick is string       && d.nick.size() <= 50
        && d.handle is string     && d.handle.size() <= 50
        && d.greeting is string   && d.greeting.size() <= 300
        && d.note is string       && d.note.size() <= 500
        && d.more is string       && d.more.size() <= 200
        && d.chars is string      && d.chars.size() <= 30000
        && d.pairsSens is string  && d.pairsSens.size() <= 10000
        && d.pairsSafe is string  && d.pairsSafe.size() <= 10000
        && d.badges is list       && d.badges.size() <= 30
        && d.warns is list        && d.warns.size() <= 30
        && d.mute is list         && d.mute.size() <= 30
        && d.likes is list        && d.likes.size() <= 30;
    }

    // 프로필 문서: 누구나 읽기, 주인만 쓰기, 삭제는 불가
    match /profile/{docId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidProfile(request.resource.data);
      allow delete: if false;
    }

    // 그 외 모든 경로는 막아둬요
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
